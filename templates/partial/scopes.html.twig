{# Each active search scope is shown as a checked checkbox, consistent with the
   other facets; unchecking it broadens the search to all manuals. #}
{% for activeScope in activeScopes %}
    <div class="aggregation">
        <div class="aggregation-title">
            <span class="fs-4 fw-bold aggregation-title-text">{{ activeScope.title }}</span>
        </div>
        <div class="aggregation-body">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="scope-{{ loop.index }}" name="{{ activeScope.name }}" value="{{ activeScope.value }}" checked onchange="this.form.submit()">
                <label class="form-check-label" for="scope-{{ loop.index }}">{{ activeScope.value }}</label>
            </div>
        </div>
    </div>
{% endfor %}
